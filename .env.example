# =====================================================================
# Variables de entorno requeridas para desarrollo local (.env.example)
# Copia este archivo a .env y asigna valores reales antes de ejecutar.
# NUNCA subas el archivo .env con credenciales reales al repositorio.
# =====================================================================

# --- Base de Datos PostgreSQL ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=banco
PGUSER=postgres
PGPASSWORD=

# --- Redis Cache ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Seguridad JWT y Cifrado Biométrico (Obligatorios) ---
# Mínimo 32 caracteres (256 bits) para HMAC-SHA256
JWT_SECRET=
# Semilla secreta para cifrado AES-256-GCM de plantillas biométricas
SECURITY_ENCRYPTION_AES_KEY=
# Opcional: correo del usuario que se promoverá a ADMIN al arrancar (vacío = ninguno)
SECURITY_BOOTSTRAP_ADMIN_EMAIL=

# --- GestoPago API (Obligatorios) ---
GESTOPAGO_AUTH_URL=https://gestopago.portalventas.net
GESTOPAGO_ID_DISTRIBUIDOR=
GESTOPAGO_CODIGO_DISPOSITIVO=
GESTOPAGO_PASSWORD=
# Opcional: token Bearer fijo si ya se cuenta con uno activo del día
GESTOPAGO_BEARER_TOKEN=
# Llave AES-256 (32 bytes en Base64) e IV (16 bytes en Base64) para cifrado de payload
GESTOPAGO_SECRET_KEY=
GESTOPAGO_IV=
GESTOPAGO_UNIDAD=086
GESTOPAGO_API_KEY=

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000

# --- Brevo (Correo transaccional para verificación y códigos 2FA) ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@bancodigital.com
BREVO_SENDER_NAME=Banco Digital

