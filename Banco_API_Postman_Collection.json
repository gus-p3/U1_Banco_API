{
  "info": {
    "_postman_id": "banco-api-collection-2026",
    "name": "Banco API - Colección Oficial (Dev)",
    "description": "Colección completa de pruebas para Banco API.\nIncluye endpoints de salud, autenticación tradicional y biométrica (Alejandro Hernández), catálogos, onboarding con clave de entidad, búsqueda unificada por POST y edición por CURP/RFC sin exponer IDs sensibles de usuario.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "demoEmail",
      "value": "alejandro.hernandez@banco-demo.com",
      "type": "string"
    },
    {
      "key": "demoCurp",
      "value": "HERA900515HDFRND01",
      "type": "string"
    },
    {
      "key": "demoRfc",
      "value": "HERA900515AB1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "00. Salud Servidor",
      "item": [
        {
          "name": "Ping Servidor Vivo (Root /)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            },
            "description": "Devuelve HTTP 200 y 'conectado servidor vivo' sin requerir sesión activa."
          }
        },
        {
          "name": "Health Check (/health)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "01. Autenticación y Sesión",
      "item": [
        {
          "name": "Login Tradicional (Alejandro Hernández)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('authToken', json.token);",
                  "    pm.collectionVariables.set('refreshToken', json.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alejandro.hernandez@banco-demo.com\",\n  \"password\": \"PasswordSegura#2026\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "login"]
            }
          }
        },
        {
          "name": "Login Biométrico (Alejandro Hernández)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('authToken', json.token);",
                  "    pm.collectionVariables.set('refreshToken', json.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alejandro.hernandez@banco-demo.com\",\n  \"biometricType\": \"HUELLA\",\n  \"biometricData\": \"dGhpcy1pcy1hLXZhbGlkLWJpb21ldHJpYy1zaWduYXR1cmUtZGF0YQ==\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/login-biometrico",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "login-biometrico"]
            }
          }
        },
        {
          "name": "Estado de Sesión Servidor (login = true/false)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/session-status",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "session-status"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/logout?email={{demoEmail}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "logout"],
              "query": [
                {
                  "key": "email",
                  "value": "{{demoEmail}}"
                }
              ]
            }
          }
        }
      ]
    },
