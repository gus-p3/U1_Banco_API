# ================================
# Copia este archivo a application.properties y rellena tus valores
# ================================

spring.application.name=banco

# Base de Datos PostgreSQL
spring.datasource.url=jdbc:postgresql://localhost:5432/banco
spring.datasource.username=TU_USUARIO_DB
spring.datasource.password=TU_CONTRASENA_DB
spring.cloud.config.enabled=false

# INEGI Catálogos Geográficos API Base URL
inegi.api.base-url=https://gaia.inegi.org.mx/wscatgeo/v2
inegi.api.connect-timeout=5000
inegi.api.read-timeout=10000

# Configuración de Negocio Bancario
bank.account.initial-balance=1000.00

# Configuración de Timeouts para Feign Client / HTTP
spring.cloud.openfeign.client.config.default.connect-timeout=5000
spring.cloud.openfeign.client.config.default.read-timeout=5000

# Redis
spring.data.redis.host=localhost
spring.data.redis.port=6379

# Documentación Interactiva Swagger UI / OpenAPI 3
springdoc.swagger-ui.path=/swagger-ui.html
springdoc.api-docs.path=/v3/api-docs
springdoc.swagger-ui.operations-sorter=method
springdoc.swagger-ui.tags-sorter=alpha
springdoc.swagger-ui.display-request-duration=true

# Control de Sesión en el Servidor (5 minutos = 300 segundos de inactividad)
server.session.inactivity-limit-seconds=300

# Expiración de Access Token JWT (5 minutos = 300 segundos)
jwt.access-token-expiration-seconds=300


# GestoPago
gestopago.auth.url=https://gestopago.portalventas.net
gestopago.auth.id-distribuidor=
gestopago.auth.codigo-dispositivo=
gestopago.auth.password=
gestopago.auth.token-max-age-hours=23
gestopago.crypto.secret-key=${GESTOPAGO_SECRET_KEY:}
gestopago.crypto.iv=${GESTOPAGO_IV:}
gestopago.tx.unidad=086
gestopago.tx.api-key=${GESTOPAGO_API_KEY:}
gestopago.tx.connect-timeout-ms=5000
gestopago.tx.read-timeout-ms=65000
gestopago.tx.espera-confirmacion-segundos=62
gestopago.tx.vigencia-confirmacion-horas=24
gestopago.tx.codigos-producto-inexistente=
gestopago.tx.codigos-no-aplicada=70
