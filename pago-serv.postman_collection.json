        {
          "name": "Actualizar Persona",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan\",\n  \"apellidoP\": \"Pérez\",\n  \"apellidoMaterno\": \"González\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/personasActualiza",
              "host": ["{{baseUrl}}"],
              "path": ["personasActualiza"]
