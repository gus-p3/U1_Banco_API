                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/personasElimina",
              "host": ["{{baseUrl}}"],
              "path": ["personasElimina"]
            },
            "description": "Elimina/inactiva una persona por nombre."
          },
          "response": []
        }
      ]
