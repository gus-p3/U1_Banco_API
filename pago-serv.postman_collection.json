        {
          "name": "Crear Persona",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan\",\n  \"apellidoP\": \"Pérez\",\n  \"apellidoMaterno\": \"Gómez\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/personas",
              "host": ["{{baseUrl}}"],
              "path": ["personas"]
            },
            "description": "Crea un nuevo registro de persona en el sistema."
